# ---------------------------------------------------------------------------
# Pasaporte de Café — variables de entorno
# Copia este archivo a .env.local y rellena los valores. .env.local NUNCA se commitea.
# ---------------------------------------------------------------------------

# --- Supabase -------------------------------------------------------------
# Dashboard > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Sólo servidor. Se usa para invitar usuarios (auth.admin.*). Nunca exponer al cliente.
SUPABASE_SERVICE_ROLE_KEY=

# --- App ------------------------------------------------------------------
# URL base para construir el redirect del magic link (ej. http://localhost:3000)
NEXT_PUBLIC_SITE_URL=

# --- IA: mapa tarea -> proveedor/modelo -----------------------------------
# Nunca se hardcodean en el código: ver src/lib/ai/config.ts.
# Proveedores admitidos: anthropic | google | ollama
AI_COPILOT_PROVIDER=
AI_COPILOT_MODEL=
AI_VISION_PROVIDER=
AI_VISION_MODEL=
AI_TRANSLATION_PROVIDER=
AI_TRANSLATION_MODEL=

# --- IA: credenciales por proveedor ---------------------------------------
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
# Sólo si se usa un modelo local (ej. http://localhost:11434)
OLLAMA_BASE_URL=
